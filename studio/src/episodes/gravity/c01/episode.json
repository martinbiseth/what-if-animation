{
 "id": "GravityC01",
 "slug": "gravity/c01",
 "chapter": "The heavy morning",
 "topic": "What if gravity doubled every hour?",
 "script": [
  {
   "beat": "p1",
   "text": "Seven AM. Your alarm goes off. You roll out of bed, and you hit the floor like a sack of cement."
  },
  {
   "beat": "p2",
   "text": "Your arms feel like they're full of sand. Your phone slides off the nightstand and smacks into the carpet. Hard."
  },
  {
   "beat": "p3",
   "text": "In the kitchen, your mom pours cereal. It doesn't fall into the bowl. It shoots into it. The milk lands so hard it splashes the ceiling."
  },
  {
   "beat": "p4",
   "text": "Your dog Biscuit is lying flat on the floor, like a rug. He doesn't even try to get up."
  },
  {
   "beat": "p5",
   "text": "Outside, a pigeon on the fence flaps like crazy, gets one foot in the air, and gives up."
  },
  {
   "beat": "p6",
   "text": "You check the weather app on your phone. Then a different app. The one that measures how hard the Earth is pulling. It says nineteen point six. It's supposed to say nine point eight."
  },
  {
   "beat": "p7",
   "text": "Gravity just doubled. And at eight o'clock, it's going to double again."
  },
  {
   "beat": "p8",
   "text": "What if gravity doubled every hour?"
  }
 ],
