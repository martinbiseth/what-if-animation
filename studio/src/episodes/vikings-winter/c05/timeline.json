  {
   "shot": "S8",
   "a": 475,
   "b": 516,
   "t0": 0,
   "t1": 41,
   "line": "This is stockfish."
  },
  {
   "shot": "S9",
   "a": 516,
   "b": 679,
   "t0": 0,
   "t1": 163,
   "line": "Cod, hung outside on racks and dried in the cold wind until almost all the water is gone."
  },
  {
   "shot": "S10",
   "a": 679,
   "b": 743,
   "t0": 0,
   "t1": 64,
   "line": "Dried like this, it keeps for years."
  },
  {
   "shot": "S11",
   "a": 743,
   "b": 827,
   "t0": 0,
   "t1": 84,
   "line": "To eat it, you beat it with a hammer, then soak it."
  },
  {
   "shot": "S12",
   "a": 827,
   "b": 869,
   "t0": 0,
   "t1": 42,
   "line": "Asa shows you how."
  },
  {
   "shot": "S13",
   "a": 869,
   "b": 930,
   "t0": 0,
   "t1": 61,
   "line": "She is way too good at the hammer part."
  },
  {
   "shot": "S14",
   "a": 930,
   "b": 1141,
   "t0": 0,
   "t1": 211,
   "line": "There's barley porridge. Butter. Hard cheese. A thick, sour milk called skyr. Salted meat."
  },
  {
   "shot": "S15",
   "a": 1141,
   "b": 1191,
   "t0": 0,
   "t1": 50,
   "line": "All of it heavy with fat."
  },
  {
   "shot": "S16",
   "a": 1191,
   "b": 1239,
   "t0": 0,
   "t1": 48,
   "line": "That's not an accident."
  },
  {
   "shot": "S17",
   "a": 1239,
   "b": 1366,
   "t0": 0,
   "t1": 127,
   "line": "Your body is a furnace too, and in this cold it burns through fuel fast."
  },
  {
   "shot": "S18",
   "a": 1366,
   "b": 1544,
   "t0": 0,
   "t1": 178,
   "line": "Today, modern armies give soldiers working in arctic cold around four and a half thousand calories a day."
  },
  {
   "shot": "S19",
   "a": 1544,
   "b": 1626,
   "t0": 0,
   "t1": 82,
   "line": "Fat is the most packed fuel there is."
  },
  {
   "shot": "S20",
   "a": 1626,
   "b": 1730,
   "t0": 0,
   "t1": 104,
   "line": "After eating, Asa drags you out to the frozen lake. She"
  },
  {
   "shot": "S21",
   "a": 1730,
   "b": 1799,
   "t0": 0,
   "t1": 69,
   "line": "straps on skates made from animal bone, and"
