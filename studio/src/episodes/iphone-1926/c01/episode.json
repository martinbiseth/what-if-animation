{
 "id": "Iphone1926C01",
 "slug": "iphone-1926/c01",
 "chapter": "Cold open",
 "topic": "What if you had an iPhone 100 years ago?",
 "script": [
  {
   "beat": "cold open: arrival",
   "text": "You wake up on a cobblestone street. Horses. Hats. Smoke. And everyone is staring at the glowing thing in your hand."
  },
  {
   "beat": "demo 1: photo",
   "text": "Your phone. You snap a photo. In full color. Instantly. A man in a bowler hat faints."
  },
  {
   "beat": "demo 2: music",
   "text": "You play a song. A crowd forms. Nobody here has ever heard music come out of a pocket."
  },
  {
   "beat": "demo 2b: the policeman",
   "text": "A policeman asks if it's a bomb. You show him a cat video. He laughs so hard he drops his whistle."
  },
  {
   "beat": "demo 3: the date",
   "text": "You grab a newspaper. October, 1926. One hundred years ago. And the only smartphone on Earth is yours."
  },
  {
   "beat": "title card",
   "text": "What if you had an iPhone, one hundred years ago?"
  },
  {
   "beat": "the turn",
   "text": "Sounds like you'd be a god. But that little phone is about to become the most dangerous object on the planet. And it's already counting down."
  }
 ],
