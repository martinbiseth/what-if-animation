{
 "id": "BackTo2010C01",
 "slug": "back-to-2010/c01",
 "chapter": "Cold open",
 "topic": "What if you went back to 2010 with $100?",
 "script": [
  {
   "beat": "c01 p1",
   "text": "You wake up and something is wrong. Your phone is gone. On the desk there's a chunky old laptop, and a phone with actual buttons."
  },
  {
   "beat": "c01 p2",
   "text": "The TV is talking about a brand new phone called the iPhone 4. Brand new."
  },
  {
   "beat": "c01 p3",
   "text": "The calendar on the wall says May 2010."
  },
  {
   "beat": "c01 p4",
   "text": "You run downstairs. Mum looks sixteen years younger. Your little sister Ellie is tiny again, watching cartoons in a onesie."
  },
  {
   "beat": "c01 p5",
   "text": "In your pocket, there's one thing. A single, crumpled one hundred dollar bill."
  },
  {
   "beat": "c01 p6",
   "text": "And then it hits you. You remember everything. Every winner. Every crash. Every app that's about to change the world. Somewhere on the internet right now, a guy is about to pay ten thousand bitcoins for two pizzas."
  },
  {
   "beat": "c01 p7",
   "text": "You know how this story ends. Nobody else does."
  },
  {
   "beat": "c01 p8",
   "text": "So what would you actually do, if you went back to 2010 with just one hundred dollars?"
  }
 ],
