{
 "slug": "hear-thoughts/c06",
 "title": " ",
 "fps": 30,
 "total": 2482,
 "segments": [
  {
   "shot": "S1",
   "a": 0,
   "b": 58,
   "t0": 0,
   "t1": 58,
   "line": "After school, she's waiting at the gate."
  },
  {
   "shot": "S2",
   "a": 58,
   "b": 121,
   "t0": 0,
   "t1": 63,
   "line": "'It's loud, isn't it? ' she says."
  },
  {
   "shot": "S3",
   "a": 121,
   "b": 202,
   "t0": 0,
   "t1": 81,
   "line": "'All the time. I know. I had it for six years."
  },
  {
   "shot": "S4",
   "a": 202,
   "b": 223,
   "t0": 0,
   "t1": 21,
   "line": "' 'Had? '"
  },
  {
   "shot": "S5",
   "a": 223,
   "b": 301,
   "t0": 0,
   "t1": 78,
   "line": "'I gave it away. And I can make yours stop."
  },
  {
   "shot": "S6",
   "a": 301,
   "b": 406,
   "t0": 0,
   "t1": 105,
   "line": "Tonight. Silence. Forever. ' Silence."
  },
  {
   "shot": "S7",
   "a": 406,
   "b": 466,
   "t0": 0,
   "t1": 60,
   "line": "You think about sleeping a whole night."
  },
  {
   "shot": "S8",
   "a": 466,
   "b": 538,
   "t0": 0,
   "t1": 72,
   "line": "About Mo, and what he thought in the dark."
  },
  {
   "shot": "S9",
   "a": 538,
   "b": 598,
   "t0": 0,
   "t1": 60,
   "line": "About never hearing another lie."
  },
  {
   "shot": "S10",
   "a": 598,
   "b": 643,
   "t0": 0,
   "t1": 45,
   "line": "It's the only thing you want."
  },
  {
   "shot": "S11",
   "a": 643,
   "b": 763,
   "t0": 0,
   "t1": 120,
   "line": "'What's the catch? ' you ask. 'No catch, ' Nora says."
  },
  {
   "shot": "S12",
   "a": 763,
   "b": 820,
   "t0": 0,
   "t1": 57,
   "line": "And you can't tell if she's lying."
  },
  {
   "shot": "S13",
   "a": 820,
   "b": 997,
   "t0": 0,
   "t1": 177,
   "line": "For the first time in weeks, you have no idea what someone is thinking. It feels strange. It feels almost nice."
  },
  {
   "shot": "S14",
   "a": 997,
   "b": 1111,
   "t0": 0,
   "t1": 114,
   "line": "Then you go home, and Ellie is at the kitchen table, drawing."
  },
  {
   "shot": "S15",
   "a": 1111,
   "b": 1201,
   "t0": 0,
   "t1": 90,
   "line": "'School was great, ' she says, and smiles."
  },
  {
   "shot": "S16",
   "a": 1201,
   "b": 1345,
   "t0": 0,
   "t1": 144,
   "line": "But her head says something else. 'Don't tell. If you tell, they'll do it more."
  },
  {
   "shot": "S17",
   "a": 1345,
   "b": 1396,
   "t0": 0,
   "t1": 51,
   "line": "Don't tell. Don't tell. '"
  },
  {
   "shot": "S18",
   "a": 1396,
   "b": 1483,
   "t0": 0,
   "t1": 87,
   "line": "Your little sister has been scared every day for a month."
  },
  {
   "shot": "S19",
   "a": 1483,
   "b": 1549,
   "t0": 0,
   "t1": 66,
   "line": "And nobody knew. Except you."
  },
  {
   "shot": "S20",
   "a": 1549,
   "b": 1633,
   "t0": 0,
   "t1": 84,
   "line": "The next morning, Nora is at the gate. 'Well?"
  },
  {
   "shot": "S21",
   "a": 1633,
   "b": 1666,
   "t0": 0,
   "t1": 33,
   "line": "' You think of Ellie."
  },
  {
   "shot": "S22",
   "a": 1666,
   "b": 1717,
   "t0": 0,
   "t1": 51,
   "line": "'No. I'm keeping it. '"
  },
  {
   "shot": "S23",
   "a": 1717,
   "b": 1840,
   "t0": 0,
   "t1": 123,
   "line": "Nora stops smiling. 'Okay, ' she says. 'Your choice. '"
  },
  {
   "shot": "S24",
   "a": 1840,
   "b": 1885,
   "t0": 0,
   "t1": 45,
   "line": "And she walks away."
  },
  {
   "shot": "S25",
   "a": 1885,
   "b": 2065,
   "t0": 0,
   "t1": 180,
   "line": "That afternoon, you go with Ellie to her teacher. You know exactly what to say, and exactly who to name."
  },
  {
   "shot": "S26",
   "a": 2065,
   "b": 2197,
   "t0": 0,
   "t1": 132,
   "line": "Mo comes too. He doesn't ask how you knew. He just stands next to you."
  },
  {
   "shot": "S27",
   "a": 2197,
   "b": 2335,
   "t0": 0,
   "t1": 138,
   "line": "And for once, his head says exactly what his mouth does: 'I've got you. '"
  },
  {
   "shot": "S28",
   "a": 2335,
   "b": 2389,
   "t0": 0,
   "t1": 54,
   "line": "By Friday, it's over."
  },
  {
   "shot": "S29",
   "a": 2389,
   "b": 2482,
   "t0": 0,
   "t1": 93,
   "line": "Ellie hugs you so hard your ribs hurt."
  }
 ],
